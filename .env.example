# ==============================================================================
# KRISHI MITRA ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env (or configure in Vercel Dashboard > Project Settings > Environment Variables)
# DO NOT commit real secrets or production keys to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini API (Required for AI Voice & Text Chat)
# Obtain from: https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=models/gemini-3.1-flash-live-preview
GEMINI_LIVE_MODEL=models/gemini-3.1-flash-live-preview
GEMINI_TEXT_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 2. Google Maps Platform API (Required for Geocoding, Directions & Radar Map)
# Obtain from: https://console.cloud.google.com/google/maps-apis
# Recommended Restrictions: HTTP Referrer restriction or API restriction to:
# Maps JavaScript API, Geocoding API, Places API, Directions API
# ------------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ------------------------------------------------------------------------------
# 3. Open Government Data Platform (data.gov.in) API
# Obtain from: https://data.gov.in/
# Resource ID: 9ef84268-d588-465a-a308-a864a43d0070
# ------------------------------------------------------------------------------
DATA_GOV_API_KEY=your_datagov_api_key_here

# ------------------------------------------------------------------------------
# 4. Supabase / PostgreSQL Configuration (Cloud Database for Vercel)
# Obtain from: https://supabase.com/dashboard/project/<project-id>/settings/api
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
DATABASE_URL=postgresql://postgres:your_db_password@db.your-project-id.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 5. Server & Deployment Settings
# ------------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
